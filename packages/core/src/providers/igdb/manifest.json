{
  "$schema": "../provider-manifest.schema.json",
  "id": "remedia.provider.igdb",
  "kind": "provider",
  "name": "IGDB",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAppVersion": "0.1.0",
  "author": "Remedia",
  "homepage": "https://www.igdb.com",
  "recordTypes": [
    "game"
  ],
  "capabilities": [
    "metadata.search",
    "metadata.details",
    "images"
  ],
  "settings": {
    "section": "igdb",
    "fields": [
      {
        "key": "client_id",
        "type": "text",
        "required": true
      },
      {
        "key": "client_secret",
        "type": "secret",
        "required": true
      }
    ]
  }
}
