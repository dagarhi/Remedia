{
  "$schema": "../provider-manifest.schema.json",
  "id": "remedia.provider.tmdb",
  "kind": "provider",
  "name": "TMDB",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAppVersion": "0.1.0",
  "author": "Remedia",
  "homepage": "https://www.themoviedb.org",
  "recordTypes": [
    "movie",
    "series"
  ],
  "capabilities": [
    "metadata.search",
    "metadata.details",
    "images",
    "seasons"
  ],
  "settings": {
    "section": "tmdb",
    "fields": [
      {
        "key": "token",
        "type": "secret",
        "required": true
      }
    ]
  }
}
