{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remedia",
  "version": "0.1.0",
  "identifier": "io.github.dagarhi.remedia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Remedia",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "dagarhi",
    "copyright": "MIT License",
    "category": "Entertainment",
    "shortDescription": "The remedy for scattered media lists.",
    "longDescription": "Log everything you watch, read and play, locally on your own device.",
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "Remedia"
}
